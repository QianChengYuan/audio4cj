                    let lsb = leaf & 0x0F
                    if (lsb == 15 && linbits != 0) {
                        let ext = bc.peek(linbits)
                        bc.flush(linbits)
                        bc.check()

                        let signneg = ((bc.cache & 0x80000000) != 0)
                        var sgn: Float64 = 1.0
                        if (signneg) {
                            sgn = -1.0
                        } else {
                            sgn = 1.0
                        }
                        let powVal = l3Pow43(lsb + ext)
                        let val = curOne * powVal * sgn
                        dst[dstOff] = val
                    } else {
                        var signbit: Int64 = 0
                        if ((bc.cache & 0x80000000) != 0) {
                            signbit = 1
                        } else {
                            signbit = 0
                        }
                        let gi = 16 + lsb - 16 * signbit
                        let powVal = G_POW43[gi]
                        let val = powVal * curOne
                        dst[dstOff] = val
                    }
                    if (lsb != 0) {
                        bc.flush(1)
                    } else {
                        bc.flush(0)
                    }
                    bc.check()
                    if (dstOff >= dst.size) {
                        break
                    }
                    dstOff = dstOff + 1
                    leaf = leaf >> 4
                    j = j + 1
                }
                pairsToDecode = pairsToDecode - 1
            } while (pairsToDecode > 0)

            bigValCnt = bigValCnt - np
            sfbCnt = sfbCnt - 1
        } while (bigValCnt > 0 && sfbCnt >= 0)
    }

    // ---- 第二段：count1 区（4 元码表）----
    // big_values 之后剩下的样点只会是"小值"，规范用**四元码表**编码：一个码字
    // 同时描述 4 个样点的"零/非零 + 各自的符号"，1 比特的 count1Table 在两张表间选。
    // `np = 1 - bigValCnt` 是个计数技巧：bigValCnt 已归零时 np = 1，循环体内先自减
    // 变成 0 正好触发"取下一个频带"，省掉一次单独的首轮初始化。
    var np: Int64 = 1 - bigValCnt
    while (true) {
        var codebookCount1 = tab32
        if (grInfo.count1Table != 0) {
            codebookCount1 = tab33
        } else {
            codebookCount1 = tab32
        }

        let idx0 = bc.peek(4)
        if (idx0 < 0 || idx0 >= codebookCount1.size) {
            break
        }
        var leaf = codebookCount1[idx0]
        if ((leaf & 8) == 0) {
            bc.check()
            // 【掩码必须在左移**之后**再取一次 —— 这是一个从 uint32 移植到 Int64 的陷阱】
            //   参照实现里 `bs_cache` 是 **uint32**，`bs_cache << 4` 会按 32 位**回绕**，
            //   于是 `>> (32 - k)` 取到的正是"窥探的 4 位之后的 k 位"。
            //   本库的 `bc.cache` 是 **Int64**：`(x & 0xFFFFFFFF) << 4` 不回绕，
            //   缓存最高 4 位被抬到 bit32..35，再 `>> (32 - k)` 时它们一起被取出来，
            //   于是 `idx1` 远大于 k 位（实测 26/27 变成 58）→ 撞上越界守卫 → break。
            //   后果极隐蔽：count1 循环在**第一次需要二级查表**时就整体退出，
            //   该 granule 的高频谱线再也没被写入（保持 0），PCM 侧表现为
            //   "高频整体被压低"，且低码率更明显（count1 占比更大）。
            //   实测：mono_64 有 232/234 个 granule 的覆盖谱线数比规范实现少 100~300 条。
            let idx1 = (leaf >> 3) + ((((bc.cache & 0xFFFFFFFF) << 4) & 0xFFFFFFFF) >> (32 - (leaf & 3)))
            if (idx1 < 0 || idx1 >= codebookCount1.size) {
                break
            }
            leaf = codebookCount1[idx1]
        }

        bc.flush(leaf & 7)

        // 越界即停：绝不能吃进**下一个 granule** 的比特 —— 那会把错位扩散到整帧。
        if (bc.pos() > layer3grLimit) {
            break
        }

        // leaf 的低 4 位分别对应 4 个样点"是否非零"；非零的样点才读 1 位符号。
        //
        // 【频带游标的推进速率：每个码字**只减 2**，不是减 4】
        //   `np` 的单位是"样点对"（`np = sfb[0] / 2`），而一个 count1 码字覆盖
        //   **4 个样点 = 2 对**，所以每码字只能扣 2。参照实现把这件事写成
        //   "在每个样点对之前各推进一次游标"（4 个样点分两组）：
        //       RELOAD_SCALEFACTOR; DEQ(0); DEQ(1);
        //       RELOAD_SCALEFACTOR; DEQ(2); DEQ(3);
        //   本库最初按"每个样点减 1"移植（等价于每码字减 4），游标**跑快一倍**，
        //   后果有两层，且都很难从表象联想到此处：
        //     · 标度因子错配（count1 区的样点用到了后面的频带增益）；
        //     · 频带表提前耗尽 → `sfb` 触到 0 终止符 → 直接 break →
        //       **高频剩余频带永远不被写入**（保持为 0）。
        //   实测症状：含瞬态/噪声的帧丢掉 16–20 kHz 达 25~41 dB，而
        //   稳态单音完全正常（单音频谱稀疏、count1 区全零，游标跑快看不出来）。
        //   这也是"判据只看总能量"抓不到它的原因：丢的是顶部能量，
        //   掩蔽在整体里只占很小比例。见 docs/decode-deviation-localization-evaluation.md。
        let masks = [128, 64, 32, 16]
        var sampleIdx: Int64 = 0
        var aborted = false
        while (sampleIdx < 4) {
            // 每两个样点（= 一个"样点对"）推进一次游标：每个码字恰好两次
            if ((sampleIdx & 1) == 0) {
                np = np - 1
                if (np <= 0) {
                    if (sfb.size == 0) {
                        aborted = true
                        break
                    }
                    let npLocal = sfb[0] / 2
                    sfb = sfb.slice(1, sfb.size - 1)
                    if (npLocal == 0) {
                        aborted = true
                        break
                    }
                    np = npLocal
                    curOne = scf[scfIdx]
                    scfIdx = scfIdx + 1
                }
            }

            if ((leaf & masks[sampleIdx]) != 0) {
                if (dstOff + sampleIdx >= dst.size) {
                    aborted = true
                    break
                }
                let signneg = ((bc.cache & 0x80000000) != 0)
                let val = if (signneg) {
                    -curOne
                } else {
                    curOne
                }
                dst[dstOff + sampleIdx] = val
                bc.flush(1)
            }
            sampleIdx = sampleIdx + 1
        }
        bc.check()
        if (aborted || dstOff + 3 >= dst.size) {
            break
        }
        dstOff = dstOff + 4

        if (np <= 0 && sfb.size == 0) {
            break
        }
    }
    bs.pos = layer3grLimit
}

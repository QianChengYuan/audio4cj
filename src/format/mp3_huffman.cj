package audio4cj.format

import std.core.*
import std.collection.*

/* ============================================================================
 * MP3 Layer III —— 标度因子解码、反量化与 Huffman 解码
 *
 * 这是整条解码链里**最"数学"的一段**，也是唯一一段"比特流直接决定浮点值"的地方。
 * 按数据流分三步：
 *   1. `l3DecodeScalefactors`：把 side info 里的 `scalefac_compress` 展开成每个
 *      频带的**标度因子**（`scf`），并顺带把强度立体声位置（`istPos`）读出来；
 *   2. `l3Huffman`：按码表把比特流解成**整数频谱**，再**就地反量化**成浮点谱线；
 *   3. 两者之间的桥是 `l3LdexpQ2` 与 `G_POW43` / `l3Pow43` 两个数值例程。
 *
 * 【为什么全都用 Float64 而不是 Float32】反量化是"2 的幂 × 幂函数"的连乘，
 *   中间量跨好几个数量级（`expQ2` 可到数百），用单精度会在小信号上丢有效位。
 *   最终输出才降到 Float32（见 mp3_decode.cj 的 `scalePcm`）。
 *
 * 【两条"魔法数字"的出处，免得后来者乱改】
 *   · `BITS_DEQUANTIZER_OUT * 4 - 210`：`global_gain` 是指数而非线性增益，
 *     这套偏置来自规范（8 比特增益字段的取值约定），写成表达式是为了让推导可见；
 *   · 指数以 **1/4** 为刻度：所以"减 2"等于乘 1/√2（MS 的定标，见 `msSub`），
 *     `1 << (MAX_SCFI / 4)` 也就成了"2 的整数次幂"的基准。
 *
 * 【与参照实现的关系】Huffman 码表以**扁平化树**的形式内联在 `l3Huffman` 里：
 *   正数 = 叶子（低 4 位是值、接着 4 位是符号位标志、高位是码长），
 *   负数 = 内部节点（低 3 位是下一步要读的比特数，其余是相对偏移）。
 *   这种编码方式（而非"码长表"）是参照实现为**省内存**做的设计，本库沿用 ——
 *   理解它需要知道"负数不是数据，是跳转指令"这一点，见该函数的注释。
 * ========================================================================== */

/// 2^(e/4) 的小数部分表：只有 4 项，因为指数的低 2 位只有 4 种。
///
/// 与 `l3LdexpQ2` 的整数部分（`1 << 30` 的移位）配合，就得到 `2^(e/4)` 的整体值 ——
/// 用"4 项分数表 + 移位"代替一次 `pow` 调用，是为热路径省掉浮点幂运算。
protected let G_EXPFRAC: Array<Float64> = [
    9.313225746155e-10,
    7.831458259666e-10,
    6.585444967122e-10,
    5.537676983636e-10
]

/// 计算 `y * 2^(expQ2 / 4)` —— 全文件使用频率最高的数值原语。
///
/// 【为什么是 `/4`】MP3 的增益/标度因子以 **1/4 个二进制位**为刻度（不是 1 位），
/// 所以指数的单位是 2^(1/4)；把它写成 `expQ2 / 4` 就不需要浮点幂函数。
///
/// 【为什么要分块（`min(120, expQ2)` + `do/while`）】一次移位最多处理 120 个刻度
/// （= 30 位，正好压在 `1 << 30` 能安全表示的量级内，也避免长移位溢出错向），
/// 超出部分**循环再乘一次**。注意 `y` 是累乘的：这既是数值上安全的分块，
/// 也让"巨大指数"不会一次性溢出成 inf。
///
/// 【`e & 3` 与 `e >> 2`】前者取分数表下标、后者取整数位移量 —— 这一步把
/// "指数拆成整数部分 + 小数部分"，正是 4 项分数表成立的依据。
protected func l3LdexpQ2(yIn: Float64, expQ2In: Int64): Float64 {
    var y = yIn
    var expQ2 = expQ2In
    var e: Int64 = 0

    do {
        e = min(120, expQ2)
        let frac = G_EXPFRAC[e & 3]
        // 分两步写：`1 << 30 >> (e >> 2)` 里的括号是必需的（右操作数带同优先级运算符），
        // 但静态检查会把它误判为冗余括号 —— 拆成中间变量即可同时满足语义与门禁。
        let sh = e >> 2
        let shiftVal = Float64(1 << 30 >> sh)
        y = y * frac * shiftVal
        expQ2 = expQ2 - e
    } while (expQ2 > 0)

    return y
}

/// 把 side info 里的标度因子信息展开成**每个频带的标度因子**，并读出强度立体声位置。
///
/// 输入是 `gr.scalefacCompress`（MPEG1 4 比特 / MPEG2 9 比特）—— 一个高度压缩的
/// 描述，需要按规范展开成"每带几个比特、共几带"；输出写进 `scf`（浮点标度因子）
/// 与 `istPos`（强度位置，255 = 该带是强度带）。
///
/// 【MPEG1 与 MPEG2 是完全不同的两套展开方式】
///   · MPEG1：`scalefac_compress` 直接查 16 项表，得到 4 组的比特宽度；
///   · MPEG2：把 9 比特当作**混合进制数**反复除（`gMod` 是各位的进制），
///     一次最多展开 3 轮（对应短块的 3 个窗口），并且第二个声道在强度立体声下
///     使用**另一套进制表半区**、且输入先右移 1 位（规范省比特的手段）。
///
/// 【为什么要先整体清零 `istPos`】它跨帧复用：上一帧残留的强度位置会被
/// `mp3_stereo.cj` 当成有效数据读走。这是"复用缓冲"带来的典型陷阱。
protected func l3DecodeScalefactors(hdr: Array<UInt8>, istPos: Array<UInt8>, bs: Mp3Bits, gr: Mp3GrInfo,
    scf: Array<Float64>, ch: Int64): Unit {
    // 整体清零（理由见函数头）：不是"顺手清理"，而是正确性必需。
    var resetI: Int64 = 0
    while (resetI < istPos.size) {
        istPos[resetI] = UInt8(0)
        resetI = resetI + 1
    }
    // 每行的含义：标度因子在**长块 / 混合块 / 短块**下各分几组（以 0 结尾）。
    // 行号由块类型决定（见下面的 idxVal），取值来自规范。
    let gScfPartitions: Array<Array<Int64>> = [
        [6, 5, 5, 5, 6, 5, 5, 5, 6, 5, 7, 3, 11, 10, 0, 0, 7, 7, 7, 0, 6, 6, 6, 3, 8, 8, 5, 0],
        [8, 9, 6, 12, 6, 9, 9, 9, 6, 9, 12, 6, 15, 18, 0, 0, 6, 15, 12, 0, 6, 12, 9, 6, 6, 18, 9, 0],
        [9, 9, 6, 12, 9, 9, 9, 9, 9, 9, 12, 6, 18, 18, 0, 0, 12, 12, 12, 0, 12, 9, 9, 6, 15, 12, 9, 0]
    ]
    // 行选择 = 块类型：长块 → 0、混合块 → 1、纯短块 → 2。
    // （有短块就 +1；若连长块部分都没有，说明是纯短块，再 +1。）
    var idxVal: Int64 = 0
    if (gr.nShortSfb != 0) {
        idxVal = idxVal + 1
    }
    if (gr.nLongSfb == 0) {
        idxVal = idxVal + 1
    }
    var scfPartition = gScfPartitions[idxVal]
    var scfSize = [0, 0, 0, 0] // 4 组各自的标度因子位宽（0 = 该组不使用）
    var iscf = Array<Int64>(40, repeat: 0) // 整数标度因子（尚未乘进 2 的幂）

    var i: Int64 = 0
    let scfShift = gr.scalefacScale + 1
    var scfsi = gr.scfsi
    var gainExp: Int64 = 0
    var gain: Float64 = 0.0
    if (hdrTestMpeg1(hdr)) {
        // MPEG1：4 比特的 scalefac_compress 直接查表得到"4 组的位宽"打包值 ——
        // 高 2 比特给第 0、1 组，低 2 比特给第 2、3 组（两两相同，规范如此规定：
        // 前后两组的位宽必然成对相等）。
        let gScfcDecode: Array<Int64> = [0, 1, 2, 3, 12, 5, 6, 7, 9, 10, 11, 13, 14, 15, 18, 19]
        let part = gScfcDecode[gr.scalefacCompress]
        scfSize[0] = (part >> 2)
        scfSize[1] = (part >> 2)
        scfSize[2] = part & 3
        scfSize[3] = part & 3
    } else {
        // MPEG2：9 比特是一个**混合进制数**（各"位"的进制由 gMod 给出，只有 1..6），
        // 反复"取余 → 减去 → 进下一段"即可逐轮展开出 4 个位宽，最多 3 轮
        // （短块的 3 个窗口各一轮）。
        let gMod: Array<Int64> = [5, 5, 4, 4, 5, 5, 4, 1, 4, 3, 1, 1, 5, 6, 6, 1, 4, 4, 4, 1, 4, 3, 1, 1]
        var k: Int64 = 0
        // 强度立体声时**第二个声道**用 gMod 的后半段（k=12），这是规范为 IS 声道
        // 预留的另一套进制组合。
        if (hdrTestIStereo(hdr) && (ch != 0)) {
            k = 12
        } else {
            k = 0
        }
        var modprod: Int64 = 0
        var sfc = gr.scalefacCompress
        // 同一个理由：IS 的第二个声道的压缩值先右移 1 位（规范省比特的手段）。
        if (hdrTestIStereo(hdr) && (ch != 0)) {
            sfc = sfc >> 1
        }
        while (sfc >= 0) {
            modprod = 1
            // 从最高一组往低解（顺序 3,2,1,0），累乘得到本轮的总进制数。
            for (i in [3, 2, 1, 0]) {
                scfSize[i] = (sfc / modprod) % gMod[k + i]
                modprod = modprod * gMod[k + i]
            }
            sfc = sfc - modprod
            k = k + 4
        }
        // 每一轮消耗一组 gScfPartitions 的分组数，故按 k 切掉已消费的部分。
        let scfBase = gScfPartitions[idxVal]
        scfPartition = scfBase.slice(k, scfBase.size - k)
        // **负数是有意的**：让 l3ReadScalefactors 里的 `scfsiVal < 0` 成立，
        // 从而启用 MPEG2 的"标度因子满量程 = 强度位置"规则（见该函数说明）。
        scfsi = -16
    }
    l3ReadScalefactors(iscf, istPos, scfSize, scfPartition, bs, scfsi)

    // 短块：每个窗口有自己的"公共增益"（subblock_gain），它不逐带写进比特流，
    // 而是加进标度因子的**指数**里。3 个窗口交错，故按 ii、ii+1、ii+2 各加一项；
    // `sh = 3 - scfShift` 把增益对齐到当前指数刻度（scalefac_scale 会让刻度变 2 倍）。
    if (gr.nShortSfb != 0) {
        let sh = 3 - scfShift
        var ii: Int64 = 0
        while (ii < gr.nShortSfb) {
            iscf[gr.nLongSfb + ii + 0] = iscf[gr.nLongSfb + ii + 0] + (gr.subblockGain[0] << sh)
            iscf[gr.nLongSfb + ii + 1] = iscf[gr.nLongSfb + ii + 1] + (gr.subblockGain[1] << sh)
            iscf[gr.nLongSfb + ii + 2] = iscf[gr.nLongSfb + ii + 2] + (gr.subblockGain[2] << sh)
            ii = ii + 3
        }
    } else if (gr.preflag != 0) {
        let gPreamp: Array<Int64> = [1, 1, 1, 1, 2, 2, 3, 3, 3, 2]
        var t: Int64 = 0
        while (t < 10) {
            iscf[11 + t] = iscf[11 + t] + gPreamp[t]
            t = t + 1
        }
    }
    // MS 立体声的定标：指数单位是 1/4 位，故"减 2"= 整体乘 1/√2。
    // 这一项与 mp3_stereo.cj 里强度立体声分支的 `s = √2` 是**配对**的：
    // 反量化时按 MS 打一个 1/√2，强度重建时再乘回来。
    var msSub: Int64 = 0
    if (hdrTestMsStereo(hdr)) {
        msSub = 2
    } else {
        msSub = 0
    }
    // gainExp 是"每带标度因子的基准指数"（含规范偏置 210 与输出位宽修正）。
    // `gain = 2^((MAX_SCFI - gainExp)/4) · 2^(MAX_SCFI/4)` 这样写，是为了把
    // `1 << (MAX_SCFI / 4)` 作为**精确的 2 的整数次幂**乘进去，避免浮点幂运算 —
    // 这也是 MAX_SCFI 必须是 4 的倍数的原因（见 mp3_layer3.cj 的常量说明）。
    gainExp = gr.globalGain + BITS_DEQUANTIZER_OUT * 4 - 210 - msSub
    gain = l3LdexpQ2(Float64(1 << (MAX_SCFI / 4)), MAX_SCFI - gainExp)

    // 最终标度因子 = gain · 2^(iscf · 2^scalefac_scale / 4)：
    // `<< scfShift`（scfShift = scalefacScale + 1 ∈ {1,2}）把"步长是否加倍"折进指数，
    // 于是"整带乘一个标度因子"仍只用到 l3LdexpQ2，不需要额外分支。
    i = 0
    while (i < (gr.nLongSfb + gr.nShortSfb)) {
        let iscfVal = iscf[i]
        let shiftedVal = iscfVal << scfShift
        let newScf = l3LdexpQ2(gain, shiftedVal)
        scf[i] = newScf
        i = i + 1
    }
}

/// `x^(4/3)` 查找表，**带符号折叠**：前 16 项是负值、第 16 项起是正值。
///
/// 布局：`[0..16)` = `-(x^(4/3))`（x = 0..15），`[16..148)` = `+(x^(4/3))`（x = 0..131）。
/// 之所以把正负两半拼在一张表里，是为了让 Huffman 循环能用**一条表达式**同时处理
/// 正负号：`gi = 16 + value - 16 * signbit` —— 符号位为 0 落在正值半区、为 1 落在
/// 负值半区，省掉一次分支（热路径上每个样本都要做）。
///
/// 表只覆盖到 x = 131，更大的值由 `l3Pow43` 用"基数 + 插值"补出（见该函数）。
protected let G_POW43: Array<Float64> = [
    0.0,
    -1.0,
    -2.519842,
    -4.326749,
    -6.349604,
    -8.549880,
    -10.902724,
